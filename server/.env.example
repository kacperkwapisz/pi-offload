# Public URL of the server (used in webhooks / Live Activity action buttons).
# Behind your reverse proxy, this is the externally-visible HTTPS URL.
APP_URL=https://pi-offload.yourdomain.com

# Bearer token clients must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
OFFLOAD_TOKEN=replace-me

# ActivitySmith API key for push notifications + Live Activities.
# https://activitysmith.com/docs
ACTIVITYSMITH_API_KEY=replace-me

# Optional: ActivitySmith channel slug to scope notifications. Leave blank for default.
ACTIVITYSMITH_CHANNEL=

# Where session workspaces are stored inside the container.
# Mounted as a Docker volume so sessions survive container restarts.
DATA_DIR=/data

# HTTP port (internal to the container).
PORT=3000

# Notify-on-tool-error level: "off" | "errors-only" | "all"
NOTIFY_LEVEL=errors-only
